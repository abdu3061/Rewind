{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Rewind Development",
  "description": "Permission-controlled focused browser metadata for the local Rewind desktop app. Recording starts off.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Rewind: recording off",
    "default_popup": "status.html"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'"
  }
}
